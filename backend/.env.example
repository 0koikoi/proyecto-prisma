#Plantilla de Variables de Entorno (Crear un .env y llenar los datos)

#Perfil activo: 'dev' para desarrollo, 'prod' para producción
#No manejamos prod aún, todo en dev, así que eso no se mueve
SPRING_PROFILES_ACTIVE=dev

#credenciales de Neon
DB_USER=tu_usuario_neon
DB_PASSWORD=tu_password_neon

#URL de conexión a la base de datos (con sslmode=require), sin Pool
DB_URL=jdbc:postgresql://ep-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clave secreta para generación y firma de tokens JWT
JWT_SECRET=replace_with_at_least_32_random_bytes_before_running
